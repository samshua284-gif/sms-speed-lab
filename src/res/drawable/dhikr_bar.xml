<?xml version="1.0" encoding="utf-8"?>
<!-- A single luminous frame: deep night gradient inside, one
     bright gold line around it — the words carry the light. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <gradient
        android:angle="270"
        android:startColor="#1C2E4A"
        android:centerColor="#142238"
        android:endColor="#0B1526" />
    <stroke android:width="1dp" android:color="#E8C766" />
</shape>
