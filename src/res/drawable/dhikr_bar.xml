<?xml version="1.0" encoding="utf-8"?>
<!-- Lines of light: a deep bar framed by a bright gold line and a
     softer inner line — the dhikr glows between them. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#0B1526" />
            <stroke android:width="1dp" android:color="#C9A227" />
        </shape>
    </item>
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#5C4A12" />
        </shape>
    </item>
</layer-list>
