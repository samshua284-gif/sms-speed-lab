<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/dhikrFrame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp">

                <TextView
                    android:id="@+id/dhikrText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0"
                    android:gravity="center"
                    android:shadowColor="#FFC93C"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="14"
                    android:text=""
                    android:textColor="#FFE066"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/verseBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/verseText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.5"
                        android:shadowColor="#FFD94D"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="12"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/verseRef"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center"
                        android:textColor="@color/gold"
                        android:textSize="10sp" />
                </LinearLayout>
            </FrameLayout>

            <Button
                android:id="@+id/dhikrToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="5dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="إيقاف الذكر"
                android:textColor="@color/ink"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="118dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/dunes"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="طمأنينة"
                    android:textColor="@color/gold"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مختبر قياس رسائل SMS على الشبكات الضعيفة"
                    android:textColor="@color/ink"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/panel"
            android:padding="14dp"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الإشارة الآن"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/signalDbm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/ink"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/signalMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/panel"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <EditText
                android:id="@+id/phoneInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_bg"
                android:padding="12dp"
                android:hint="رقم الهاتف"
                android:textColorHint="@color/muted"
                android:textColor="@color/ink"
                android:inputType="phone"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/messageInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_bg"
                android:padding="12dp"
                android:layout_marginTop="10dp"
                android:hint="نص الرسالة"
                android:textColorHint="@color/muted"
                android:textColor="@color/ink"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/charInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="الأحرف: 0 • الترميز: GSM-7 • الأجزاء: 1"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <CheckBox
                    android:id="@+id/attachLocCheck"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="إرفاق إحداثيات موقعي في الرسالة تلقائيًا"
                    android:textColor="@color/ink"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/sendBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/banner_emerald"
                android:padding="13dp"
                android:gravity="center"
                android:text="إرسال رسالة تلقائية عند الضغط على بدء السلسلة"
                android:textColor="@color/gold"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/panel"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="سلسلة اختبار متكرر (فاصل 15 ثانية بين المحاولات)"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <EditText
                    android:id="@+id/seriesCount"
                    android:layout_width="86dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/input_bg"
                    android:padding="10dp"
                    android:text="10"
                    android:textColor="@color/ink"
                    android:inputType="number"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/seriesBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/btn_ghost"
                    android:text="بدء السلسلة"
                    android:textColor="@color/gold"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/seriesStopBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/btn_ghost"
                    android:text="إيقاف"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/stopOnSuccessCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="إيقاف عند أول نجاح (وضع الوصول — للقياس أبقِه مطفأً)"
                android:textColor="@color/ink"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text=""
            android:textColor="@color/gold"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/panel"
            android:padding="14dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="النتائج"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/statsInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="لا محاولات مسجلة بعد"
                android:textColor="@color/ink"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/panel"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="سجل المحاولات"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/logInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="—"
                android:textColor="@color/ink"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/exportBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/btn_ghost"
                android:text="تصدير CSV"
                android:textColor="@color/gold"
                android:textSize="15sp" />

            <Button
                android:id="@+id/clearBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@drawable/btn_ghost"
                android:text="مسح السجل"
                android:textColor="@color/ink"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="طمأنينة • يقيس ولا يدّعي التسريع — الأزمنة كما تقيسها الشبكة نفسها"
            android:textColor="@color/muted"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
